{
  "name": "@ninenine-platform/game-engine-hub",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "typeorm": "NODE_OPTIONS='-r ./typeorm-register.js' TS_NODE_PROJECT=tsconfig.typeorm.json typeorm-ts-node-commonjs -d ormconfig.ts",
    "migration:generate": "pnpm typeorm migration:generate",
    "migration:create": "pnpm typeorm migration:create",
    "migration:run": "pnpm typeorm migration:run",
    "migration:revert": "pnpm typeorm migration:revert",
    "schema:drop": "pnpm typeorm schema:drop",
    "schema:sync": "pnpm typeorm schema:sync"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "--node-env=production"
          ],
          "cwd": "apps/backend/game-engine-hub"
        },
        "configurations": {
          "development": {
            "args": [
              "--node-env=development"
            ]
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/backend/game-engine-hub/dist/package.json",
          "{workspaceRoot}/apps/backend/game-engine-hub/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/backend/game-engine-hub/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@ninenine-platform/game-engine-hub:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@ninenine-platform/game-engine-hub:build:development"
          },
          "production": {
            "buildTarget": "@ninenine-platform/game-engine-hub:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@ninenine/config": "workspace:*",
    "@ninenine/core": "workspace:*",
    "@ninenine/database": "workspace:*",
    "@ninenine/contracts": "workspace:*",
    "@ninenine/game-engine": "workspace:*",
    "@ninenine/game-events": "workspace:*",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0"
  }
}
