{
  "name": "backoffice-api-e2e",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["backoffice-api"],
  "targets": {
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "options": {
        "jestConfig": "apps/backend/backoffice-api-e2e/jest.config.cts",
        "passWithNoTests": true
      },
      "dependsOn": ["backoffice-api:build", "backoffice-api:serve"]
    }
  }
}
